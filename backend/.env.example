# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma separated list of allowed origins (web app, admin panel, expo)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# ── MySQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=construction_erp
DB_CONNECTION_LIMIT=10

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=change_this_to_a_long_random_string_too
JWT_REFRESH_EXPIRES_IN=30d

# ── Password reset tokens ──────────────────────────────────────────────
RESET_TOKEN_EXPIRES_MINUTES=30
# Base URL used in the reset-password link that is generated
FRONTEND_BASE_URL=http://localhost:5173

# ── File uploads ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# ── Seed (first run) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@constructionerp.com
SEED_ADMIN_PASSWORD=Admin@123
